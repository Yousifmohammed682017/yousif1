# إعدادات الخادم
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# إعدادات التشفير والتوكنات السرية (يجب استبدالها في الإنتاج بمفاتيح قوية)
JWT_SECRET=srcs_northern_state_super_secret_jwt_key_2026_sd
SESSION_SECRET=srcs_session_enc_secret_key_northern_state_982341

# إعدادات قاعدة البيانات المشتركة (PostgreSQL)
# إذا تم ترك الرابط فارغاً، سيعتمد الخادم تلقائياً على قاعدة بيانات SQLite المحلية المدمجة الدائمة
DATABASE_URL=
# مثال للاتصال بقاعدة بيانات PostgreSQL حقيقية:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/srcs_northern_state

# مفتاح Google OAuth 2.0 المعتمد للمصادقة وتوثيق المواطنين
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# حساب المدير العام الافتراضي للتهيئة الأولية
ADMIN_INITIAL_EMAIL=admin@srcs.sd
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_USERNAME=admin.director
